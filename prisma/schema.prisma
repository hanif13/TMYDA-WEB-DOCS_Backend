generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  passwordHash     String
  name             String
  role             String            @default("VIEWER")
  permissions      String[]          @default(["VIEW"])
  departmentId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  email            String?
  facebook         String?
  phoneNumber      String?
  subDepartment    String?
  documents        Document[]        @relation("DocumentUploader")
  documentRequests DocumentRequest[] @relation("UserRequests")
  department       Department?       @relation(fields: [departmentId], references: [id])
  activityLogs     ActivityLog[]
}

model Department {
  id                     String            @id @default(uuid())
  name                   String
  subDepts               String[]
  theme                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  order                  Int               @default(0)
  thaiYear               Int               @default(2567)
  isCommitteeOnly        Boolean           @default(false)
  isHiddenInCommittee    Boolean           @default(false)
  hiddenInCommitteeYears Int[]             @default([])
  committeeMembers       CommitteeMember[]
  documents              Document[]
  events                 Event[]
  projects               Project[]
  transactions           Transaction[]
  users                  User[]

  @@unique([name, thaiYear])
  @@index([thaiYear])
}

model DocumentCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  documents   Document[]
}

model Document {
  id           String            @id @default(uuid())
  docNo        String
  name         String
  filePath     String
  departmentId String?
  categoryId   String
  uploadedById String?
  projectId    String?
  thaiYear     Int               @default(2569)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  category     DocumentCategory  @relation(fields: [categoryId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  uploadedBy   User?             @relation("DocumentUploader", fields: [uploadedById], references: [id])
  requests     DocumentRequest[]

  @@unique([docNo, thaiYear, categoryId, departmentId])
  @@index([thaiYear])
}

model DocumentRequest {
  id            String    @id @default(uuid())
  requestType   String
  department    String
  requestedBy   String
  status        String    @default("รอดำเนินการ")
  fields        Json
  pdfPath       String?
  thaiYear      Int       @default(2567)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resultDocId   String?
  requestedById String?
  user          User?     @relation("UserRequests", fields: [requestedById], references: [id])
  resultDoc     Document? @relation(fields: [resultDocId], references: [id])

  @@index([thaiYear])
}

model AnnualPlan {
  id          String    @id @default(uuid())
  year        Int       @unique
  thaiYear    Int       @unique
  label       String
  totalBudget Float     @default(0)
  totalUsed   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id                   String        @id @default(uuid())
  name                 String
  departmentId         String
  subDepartment        String?
  projectType          String
  lead                 String
  budget               Float         @default(0)
  budgetUsed           Float         @default(0)
  quarter              Int
  status               String        @default("planned")
  startDate            String?
  endDate              String?
  description          String?
  kpi                  String?
  targetPax            Int?
  actualPax            Int?
  months               Int[]         @default([])
  completedMonths      Int[]         @default([])
  summaryImages        String[]      @default([])
  isStarted            Boolean       @default(false)
  isUnplanned          Boolean       @default(false)
  annualPlanId         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  actualBudget         Float?
  actualDate           String?
  actualBudgetExternal Float         @default(0)
  projectNumber        String?
  announcementDoc      String?
  documents            Document[]
  annualPlan           AnnualPlan    @relation(fields: [annualPlanId], references: [id])
  department           Department    @relation(fields: [departmentId], references: [id])
  transactions         Transaction[]
}

model Transaction {
  id           String     @id @default(uuid())
  date         String
  title        String
  type         String
  amount       Float
  category     String?
  docRef       String?
  slipUrl      String?
  months       Int[]      @default([])
  departmentId String
  projectId    String?
  thaiYear     Int        @default(2569)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  note         String?
  claimedBy    String?
  recordedBy   String?
  department   Department @relation(fields: [departmentId], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])

  @@index([thaiYear])
}

model CommitteeMember {
  id           String     @id @default(uuid())
  name         String
  position     String
  phoneNumber  String?
  email        String?
  occupation   String?
  photoUrl     String?
  departmentId String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  thaiYear     Int        @default(2569)
  department   Department @relation(fields: [departmentId], references: [id])

  @@index([thaiYear])
}

model Transliteration {
  id        String   @id @default(uuid())
  foreign   String
  arabic    String?
  thai      String
  category  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([foreign])
  @@index([thai])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String? // The user who performed the action (nullable in case of system actions)
  action    String // e.g., "CREATE", "UPDATE", "DELETE"
  resource  String // e.g., "Document", "Transaction", "User"
  details   Json? // Optional JSON payload with what changed or the created record
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

model Event {
  id           String     @id @default(uuid())
  title        String
  departmentId String
  date         DateTime
  endDate      DateTime?
  location     String?
  description  String?
  color        String?
  thaiYear     Int        @default(2569)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department   Department @relation(fields: [departmentId], references: [id])

  @@index([thaiYear])
  @@index([date])
}

model Member {
  id               String    @id @default(uuid())

  // 1. ข้อมูลส่วนตัว
  fullName         String                          // ชื่อ-สกุล
  nickname         String?                         // ชื่อเล่น
  birthDate        DateTime?                       // วัน/เดือน/ปีเกิด
  age              Int?                            // อายุ
  bloodType        String?                         // กรุ๊ปเลือด

  // 2. ข้อมูลติดต่อ
  address          String?                         // ที่อยู่ตามทะเบียนบ้าน
  phoneNumber      String                          // เบอร์โทรติดต่อ
  email            String?                         // E-mail
  facebook         String?                         // Facebook
  lineId           String?                         // ID Line
  emergencyContact String?                         // ข้อมูลคนที่สามารถติดต่อได้ยามฉุกเฉิน

  // 3. การศึกษา
  education        String?                         // สำเร็จการศึกษาสูงสุด
  institution      String?                         // ชื่อสถานศึกษา/สถาบัน
  fieldOfStudy     String?                         // สายการเรียน/คณะ/สาขาวิชา

  // 4. อาชีพ/ข้อมูลครอบครัว
  occupation       String?                         // อาชีพปัจจุบัน
  workplace        String?                         // ชื่อสถานประกอบการ/สถานศึกษา
  workProvince     String?                         // จังหวัด สถานศึกษาหรือที่ทำงาน
  maritalStatus    String?                         // สถานะ: โสด, แต่งงานแล้ว, หย่าร้าง
  childrenBoys     Int?                            // จำนวนลูกชาย
  childrenGirls    Int?                            // จำนวนลูกหญิง
  childrenAges     String?                         // อายุปัจจุบันของลูก

  // 5. ความเกี่ยวข้องกับกลุ่มองค์กร
  knowFrom         String?                         // รู้จักกลุ่มองค์กรจากไหน
  activities       Json?                           // เคยเข้าร่วมกิจกรรมใดบ้าง (JSON)

  // 6. ข้อมูลเพิ่มเติม
  skills           String?                         // ทักษะหรือความสามารถพิเศษ
  interests        String?                         // ความสนใจพิเศษ

  // ระบบ
  status           String    @default("รอตรวจสอบ")  // สถานะการอนุมัติ
  note             String?                         // หมายเหตุจาก Admin
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([workProvince])
}

